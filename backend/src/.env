#Bellow are the MySQL Environment variables
MYSQLDBSRV=
MYSQLDBUSR=
MYSQLDBPWD=
MYSQLDBPRT=3306

APP_LANG=PT

# Application Server environment variables
ALLOW_ORIGINS=http://127.0.0.1:8080, http://localhost:8080, http://localhost:8069, http://localhost:8069/
APP_SRV_ADDR=http://localhost:8000
MISTRAL_API_KEY=
GROQ_API_KEY=


#File upload general settings
# TOTAL_ALLOWED_UPLOADS 
#   * Sets how many files can be uploaded per namespaces, 
#   * -1 means unlimited uploads
TOTAL_ALLOWED_UPLOADS=-1


#AI Agent general config
# CONVERSATION_TURN_LIMIT 
#   * Especially for demo environment, sets how many messages each user can send to AI agent, 
#   * -1 means unlimited messages
CONVERSATION_TURN_LIMIT=-1

# Secret Management
HASHICORP_HOST=http://127.0.0.1:8200
HASHICORP_TOKEN=


# Analytics resource allocation Variables
AN_TOTAL_THREADS=4
AN_MAX_MEMORY=4GB


# Email Service
MAILGUN_API_KEY=
MAILGUN_DOMAIN=e2e-data.com
FROM_EMAIL=e2e-Data - Pipeline run <pipeline.noreply@e2e-data.com>

# Pipeline Execution email receiver
PPLINE_RESULT_EMAIL=nakassony@gmail.com
PPLINE_RESULT_EMAIL_RCVR=Pipeline monitoring


# User authentication flow Envs
# chachange it to the encryption key for JWT encription
JWT_SECRET_KEY=e2e@Enryption.key
# change it to the encryption key for SQLite user storage
SQLITE_DB_ENCRYPTION_KEY=usr-db-storage-password
# root user that takes place for on-prem setup
ROOT_USERNAME=root
# Change it to the desired initial root password on-prem setup
ROOT_PASSWORD=temp@pwd
# change it with the company name for on-prem setup
USER_NAMESPACE=mycompany


# *********** Data warehouse and Stage data processing ***********

# sets how many seconds it'll wait for data to be transfered from
# stage to datawarehouse when the pipeline has both stage eligibles 
STAGE_TO_DW_WAIT_SEC=1