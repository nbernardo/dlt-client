let
    token = "jwt-token-hash",
    sql = "SELECT col1, col2, colN FROM dwname.table_naem LIMIT 100",
    namespace = "e2e-namespace",
    pipeline = "pipeline_name",
    Source = Binary.Buffer(Web.Contents(
        "http://server-ip:8000",
        [
            Headers = [ #"Authorization" = "Bearer " & token, #"Content-Type" = "application/json"],
            RelativePath = "query-parquet-export/"& namespace &"/"&pipeline,  Content = Json.FromValue([sql=sql])
        ]
    )),
    Result = ParseQueryResult(Source)
in
    Result